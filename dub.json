{
	"name": "stb",
	"license": "MIT",
	"authors": [
		"Temtaime"
	],
	"description": "stb bindings for D",
	"dflags": [
		"-I$PACKAGE_DIR/deps/import_c",
		"-P-I$PACKAGE_DIR/deps/include"
	],
	"lflags-windows": [
		"/LIBPATH:$PACKAGE_DIR/deps/lib"
	],
	"lflags-linux": [
		"-L$PACKAGE_DIR/deps/lib"
	],
	"lflags-wasm32": [
		"-L$PACKAGE_DIR/deps/lib/wasm"
	],
	"libs": [
		"stb"
	]
}
